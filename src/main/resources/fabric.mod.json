{
	"schemaVersion": 1,
	"id": "plantz_ex",
	"version": "${version}",
	"name": "Plants & Zombies - EX",
	"description": "Find and grow helpful Plants that can defend your base.",
	"authors": [
		"duskdn"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/plantz_ex/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "duskdn.plantz_ex.PazMain",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "duskdn.plantz_ex.PazClient",
				"adapter": "kotlin"
			}
		],
		"terrablender": [
			{
				"value": "duskdn.plantz_ex.init.PazWorldGen",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"plantz_ex.mixins.json",
		{
			"config": "plantz_ex.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2-",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}